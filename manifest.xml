<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>90d7b6c8-7940-47db-bf0f-7d3677682f6e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Roshdy Sayed - Math Empire</ProviderName>
  <DefaultLocale>ar-SA</DefaultLocale>
  <DisplayName DefaultValue="راسم الدوال"/>
  <Description DefaultValue="ارسم الدوال والرسومات الرياضية بالعربية وأدرجها في المستند بمقاسها الصحيح - أ. رشدي سيد"/>
  <IconUrl DefaultValue="https://roshdy1221985.github.io/rasem-dawal/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://roshdy1221985.github.io/rasem-dawal/icon-64.png"/>
  <SupportUrl DefaultValue="https://math-empire22.onrender.com"/>
  <AppDomains>
    <AppDomain>https://wa.me</AppDomain>
    <AppDomain>https://math-empire22.onrender.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://roshdy1221985.github.io/rasem-dawal/index.html?office=1"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GS.Title"/>
            <Description resid="GS.Desc"/>
            <LearnMoreUrl resid="GS.Url"/>
          </GetStarted>
          <FunctionFile resid="Pane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Rasem.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="Rasem.Open">
                  <Label resid="Btn.Label"/>
                  <Supertip>
                    <Title resid="Btn.Label"/>
                    <Description resid="Btn.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>RasemPane</TaskpaneId>
                    <SourceLocation resid="Pane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://roshdy1221985.github.io/rasem-dawal/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://roshdy1221985.github.io/rasem-dawal/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://roshdy1221985.github.io/rasem-dawal/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Pane.Url" DefaultValue="https://roshdy1221985.github.io/rasem-dawal/index.html?office=1"/>
        <bt:Url id="GS.Url" DefaultValue="https://math-empire22.onrender.com"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="راسم الدوال"/>
        <bt:String id="Btn.Label" DefaultValue="راسم الدوال"/>
        <bt:String id="GS.Title" DefaultValue="راسم الدوال جاهز"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Btn.Tip" DefaultValue="افتح راسم الدوال وأدرج الرسومات في مكان المؤشر بمقاسها الصحيح"/>
        <bt:String id="GS.Desc" DefaultValue="اضغط زر راسم الدوال في شريط الصفحة الرئيسية لبدء الرسم"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
